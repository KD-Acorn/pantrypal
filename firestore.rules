rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == 'gTCwD1bHALeeNZ7wDNbt9sSEL8x1';
    }

    function signedIn() {
      return request.auth != null;
    }

    // Membership is read from the household doc's memberUids, which only the backend writes
    // (Admin SDK). get() on a household id that does not exist is an error, i.e. denied.
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    match /push_subscriptions/{docId} {
      allow read: if request.auth != null && request.auth.uid == docId;
      allow write: if false; // only the Admin SDK (server) writes this collection
    }
    match /push_tokens/{docId} {
      allow read: if request.auth != null && request.auth.uid == docId;
      allow write: if false; // only the Admin SDK (server) writes this collection
    }
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /pantry/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /saved_recipes/{uid}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /saved_drinks/{uid}/drinks/{drinkId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /cook_history/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /substitutions/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /public_recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.authorUid &&
        request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.authorUid;
    }
    match /grocery/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /meal_plan/{uid}/days/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Events are create-only (random ids, never updated). The client sends its own uid,
    // or 'anonymous' when the call site has none, so a forged uid is the only thing to block.
    match /analytics_events/{docId} {
      allow create: if request.auth != null &&
        request.resource.data.get('uid', 'anonymous') in [request.auth.uid, 'anonymous'];
    }
    // One shared doc per day that every client increments, so ownership can't be
    // expressed here. Anyone signed in can still write it (remaining Low), but no one
    // can delete it or bloat it with arbitrary fields.
    match /analytics_daily/{docId} {
      allow create, update: if request.auth != null &&
        request.resource.data.keys().size() <= 40;
      allow delete: if false;
    }
    // Create-only: the report must be filed under the caller's own uid. Status changes
    // and deletes are done by the admin panel via the isAdmin() catch-all above.
    match /bug_reports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
    }
    // Households: members can read; every change (create, join, leave, roles, settings, rotate code,
    // disband) goes through the backend endpoints (Admin SDK), so clients never write this collection.
    // The listener query is where('memberUids', 'array-contains', uid).
    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }
    // Shared data stays on the client SDK, gated on membership. addedBy is bound to the caller on create
    // (the app always sends its own uid). Meal-plan days carry no uid and recipes have no creator
    // in the app today, so those get no field checks.
    match /household_pantry/{householdId}/items/{itemId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if isMember(householdId);
    }
    match /household_recipes/{householdId}/recipes/{recipeId} {
      allow read, write: if isMember(householdId);
    }
    match /household_meal_plan/{householdId}/days/{date} {
      allow read, write: if isMember(householdId);
    }
    // Activity is append-only for clients (the server also writes join/leave/remove events).
    match /household_activity/{householdId}/events/{eventId} {
      allow read: if isMember(householdId);
      allow create: if isMember(householdId) && request.resource.data.uid == request.auth.uid;
    }
    // Server-only. Email invites are not built yet (post-launch item #33).
    match /household_invites/{email} {
      allow read, write: if false;
    }
    match /pending_deletions/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == docId;
    }
    match /verified_products/{barcode} {
      allow read: if request.auth != null;
      allow write: if false; // only the Admin SDK (backend) and the admin panel (isAdmin() above) write this
    }
    match /user_recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.authorUid &&
        request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.authorUid;
    }
    match /recipe_comments/{recipeId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.authorUid &&
        request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.authorUid;
    }
  }
}
